package com.example.spel.service;

import org.springframework.expression.ExpressionParser;
import org.springframework.expression.spel.standard.SpelExpressionParser;
import org.springframework.stereotype.Service;

import com.example.spel.entity.SpelEntity;

@Service
public class SpelService {

	public boolean validateInput(SpelEntity inputjson) {
		ExpressionParser parser=new SpelExpressionParser();
		
		boolean isActionValid=parser.parseExpression("'findByIdentifier'==action").getValue(inputjson,Boolean.class);
				
		boolean isActionCodeValid=parser.parseExpression("actionCode matches '^Retrieve.*'").getValue(inputjson,Boolean.class);
		
		boolean isEntityCodeValid=parser.parseExpression("entityCode matches '^BSIT[0-9]{3}'").getValue(inputjson,Boolean.class);
		
		boolean isSendersReference=parser.parseExpression("filterClause[sendersReference] matches 'ORM[0-9]{3}'").getValue(inputjson,Boolean.class);
		
		return isActionValid && isActionCodeValid && isEntityCodeValid && isSendersReference;
	}
}
