        		+ "  },\n"
        		+ "  \"entityCode\": \"BSIT004\"\n"
        		+ "}";
        String schemaFilePath = "C:\\Users\\LOGESHKUMAR\\eclipse-workspace\\JsonVaildateWithJava\\src\\main\\resources\\templates\\Schema.json";
        
      String errors = schemaService.validateJson(invalidJson,schemaFilePath);
        assertFalse(errors.isEmpty());
