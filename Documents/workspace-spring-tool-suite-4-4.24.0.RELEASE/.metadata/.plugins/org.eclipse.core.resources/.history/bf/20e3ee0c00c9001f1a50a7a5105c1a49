    @Test
    void testValidInput() {
        SpelEntity inputJson = new SpelEntity();
        inputJson.setAction("findByIdentifier");
        inputJson.setActionCode("RetrieveMasterDetail");
        inputJson.setEntityCode("BSIT004");
        Map<String, String> filterClause = new HashMap<>();
        filterClause.put("sendersReference", "ORM-0012");
        inputJson.setFilterClause(filterClause);

        // Call the service
        Map<String, String> errors = spelService.validateInput(inputJson);

        // Assert no errors
        assertTrue(errors.isEmpty(), "Expected no validation errors for valid input.");
    }

    @Test
    void testInvalidAction() {
        // Prepare invalid input
        SpelEntity inputJson = new SpelEntity();
        inputJson.setAction("find"); // Too short
        inputJson.setActionCode("RetrieveMasterDetail");
        inputJson.setEntityCode("BSIT004");
        Map<String, String> filterClause = new HashMap<>();
        filterClause.put("sendersReference", "ORM-0012");
        inputJson.setFilterClause(filterClause);

        // Call the service
        Map<String, String> errors = spelService.validateInput(inputJson);

        // Assert errors
        assertFalse(errors.isEmpty(), "Expected validation errors for invalid action.");
        assertEquals("Action must be 15 to 25 alphabetic characters.", errors.get("action"));
    }

