@SpringBootTest
class SpelApplicationTests {

	private final SpelService spelService = new SpelService();

	@InjectMocks
	private SchemaValidation schemaService;
	
    ObjectMapper map = new ObjectMapper();

    
	@Test
	void testCreateEntityCodeProperty() {
		
		ObjectNode entityCodeProperty = schemaService.createEntityCodeProperty(map);

		assertNotNull(entityCodeProperty);
		assertEquals("string", entityCodeProperty.get("type").asText());
		assertEquals(3, entityCodeProperty.get("minLength").asInt());
		assertEquals("^(?![Nn][Uu][Ll][Ll]$).*", entityCodeProperty.get("pattern").asText());

		assertTrue(entityCodeProperty.has("message"));
		assertEquals("The 'entityCode' must be at least 3 characters long.",
				entityCodeProperty.get("message").get("minLength").asText());
		assertEquals("'entityCode' cannot be 'null' as a string.",
				entityCodeProperty.get("message").get("pattern").asText());
	}

	@Test
	void testInsertIntoSchema() throws JsonMappingException, JsonProcessingException {
		String schemaJson = "{\n" + "  \"type\": \"object\",\n" + "  \"properties\": {\n"
				+ "    \"entityCode\": {\"type\": \"string\"}\n" + "  }\n" + "}";

		JsonNode schemaNode = map.readTree(schemaJson);
		ObjectNode entityCodeProperty = schemaService.createEntityCodeProperty(map);

		schemaService.insertIntoSchema(schemaNode, entityCodeProperty);

		assertTrue(schemaNode.has("properties"));
		JsonNode properties = schemaNode.get("properties");
		assertTrue(properties.has("entityCode"));
		assertEquals("string", properties.get("entityCode").get("type").asText());
	}

	@Test
	void testJsonValidation() throws IOException {

		String validJson = "{\n" + "  \"action\": \"findByIdentifier\",\n"
				+ "  \"actionCode\": \"RetrieveMasterDetail\",\n" + "  \"filterClause\": {\n"
				+ "    \"sendersReference\": \"ORM-0012\"\n" + "  },\n" + "  \"entityCode\": \"BSIT004\"\n" + "}";
		String invalidJson = "{\n" + "  \"action\": \"null\",\n" + "  \"actionCode\": \"RetrieveMasterDetail\",\n"
				+ "  \"filterClause\": {\n" + "    \"sendersReference\": \"ORM-0012\"\n" + "  },\n"
				+ "  \"entityCode\": \"BSIT004\"\n" + "}";
		String schemaFilePath = "C:\\Users\\LOGESHKUMAR\\eclipse-workspace\\JsonVaildateWithJava\\src\\main\\resources\\templates\\Schema.json";
		String valid = schemaService.validateJson(validJson, schemaFilePath);

		assertEquals("Valid Json\n", valid);
		String inValid = schemaService.validateJson(invalidJson, schemaFilePath);
		assertTrue(inValid.endsWith("Invalid Json\n"));
	}
	
