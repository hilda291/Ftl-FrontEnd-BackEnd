{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "beneficiaryCustomer": {
      "type": "object",
      "properties": {
        "Account": {
          "type": "string"
        },
        "Name": {
          "type": "string"
        },
        "Add1": {
          "type": "string"
        },
        "Add2": {
          "type": "string"
        },
        "Add3": {
          "type": "string"
        },
        "IdentifierCode": {
          "type": "string"
        }
      },
      "required": ["Account"], 
      "anyOf": [
        {
          "properties": {
            "Name": { "type": "string" },
			"not":{
							"enum": ["null","Null","","NULL"," "]
						} 
          },
          "required": ["Name"],
          "dependencies": {
            "Name": ["Add1", "Add2", "Add3"],
			"not":{
										"enum": ["null","Null","","NULL"," "]
									} 
          },
		  
		  "message":{
			"dependencies":"When name is given all the three(3) addresses are mandatory",
		  		"required":"Either Name or IdentifierCode is important",
				"not":"It should not be null"
		  	  }
        },
        {
          "properties": {
            "IdentifierCode": { "type": "string" }
          },
          "required": ["IdentifierCode"],
		  "message":{
			"required":"Either Name or IdentifierCode is important"
		  }
        }
      ]
    }
  },
  "required": ["beneficiaryCustomer"]
}