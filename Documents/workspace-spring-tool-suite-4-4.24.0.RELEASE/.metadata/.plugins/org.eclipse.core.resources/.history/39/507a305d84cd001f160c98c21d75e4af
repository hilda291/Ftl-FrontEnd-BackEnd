{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "beneficiaryCustomer": {
      "type": "object",
      "properties": {
        "Account": {
          "type": "string",
		  "not":{
		  			"pattern":"^(?![Nu][Uu][Ll][Ll]$)*"
		  			},
					"pattern":"^[A-Za-z 0-9]+$",
					"message":{
						"not":"Not be be null",
						"pattern":"Must follow pattern"
					}
        },
        "Name": {
          "type": "string"
        },
        "Add1": {
          "type": "string"
        },
        "Add2": {
          "type": "string"
        },
        "Add3": {
          "type": "string"
        },
        "IdentifierCode": {
          "type": "string"
        }
      },
      "required": ["Account"], 
      "anyOf": [
        {
          "properties": {
            "Name": { "type": "string" }
          },
          "required": ["Name"],
          "dependencies": {
            "Name": ["Add1", "Add2", "Add3"]
          },
			"not":{
			"enum":["Null","NULL","null",""," "]
			},
		  "message":{
			"dependencies":"When Name is given all the three(3) addresses are mandatory",
		  		"required":"Either Name or IdentifierCode is important",
				"not":"It should not be null"
		  	  }
        },
        {
          "properties": {
            "IdentifierCode": { "type": "string",
			"not":{
				  			"enum":["Null","NULL","null",""," "]
				  			} }
          },	
          "required": ["IdentifierCode"],
		
		  "message":{
			"required":"Either Name or IdentifierCode is important",
			"not":"It should not be null"
		  }
        }
      ]
    }
  },
  "required": ["beneficiaryCustomer"]
}
