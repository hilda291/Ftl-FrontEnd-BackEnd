{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "beneficiaryCustomer": {
      "type": "object",
      "properties": {
        "Account": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["null", "NULL", "","Null"," "]
          },
          "message": {"Account": "Null or empty is not accepted"}
        },
        "Name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["null", "NULL", ""]
          },
          "errorMessage": "Name: Null or empty is not accepted"
        },
        "Add1": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["null", "NULL", ""]
          },
          "errorMessage": "Add1: Null or empty is not accepted"
        },
        "Add2": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["null", "NULL", ""]
          },
          "errorMessage": "Add2: Null or empty is not accepted"
        },
        "Add3": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["null", "NULL", ""]
          },
          "errorMessage": "Add3: Null or empty is not accepted"
        },
        "IdentifierCode": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["null", "NULL", ""]
          },
          "errorMessage": "IdentifierCode: Null or empty is not accepted"
        }
      },
      "required": ["Account"],
      "anyOf": [
        {
          "required": ["Name", "Add1", "Add2", "Add3"],
          "dependencies": {
            "Name": ["Add1", "Add2", "Add3"]
          }
        },
        {
          "required": ["IdentifierCode"]
        }
      ]
    }
  },
  "required": ["beneficiaryCustomer"],
  "errorMessage": {
    "required": "The 'beneficiaryCustomer' object is required.",
    "properties": {
      "beneficiaryCustomer": {
        "anyOf": "Either Name with all addresses (Add1, Add2, Add3) or IdentifierCode must be provided."
      }
    }
  }
}