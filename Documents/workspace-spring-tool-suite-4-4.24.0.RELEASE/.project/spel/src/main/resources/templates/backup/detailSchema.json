{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "pattern": "^[A-Za-z]{15,25}$",
      "message": {
        "pattern": "Action must be 15 to 25 alphabetic characters."
      }
    },
    "actionCode": {
      "type": "string",
      "pattern": "^[A-Za-z]{15,30}$",
      "not": {
        "enum": ["null","",null]
      },
      "message": {
        "pattern": "Action must be 15 to 30 alphabetic characters.",
        "type": "actionCode: Only strings are allowed",
        "not": "actionCode: null is not accepted as String or empty"
      }
    },
    "filterClause": {
      "sendersReference": {
        "type": "string",
        "pattern": "[A-Z]{3}-[0-9]{4}$",
        "message": {
          "pattern": "Senders Reference must match the pattern: 3 uppercase letters, a hyphen, and 4 digits."
        }
      }
    },
    "entityCode": {
      "$ref": "entityCodeProperty"
    }
  }
}