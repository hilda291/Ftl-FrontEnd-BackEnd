import org.springframework.expression.ExpressionParser;
import org.springframework.expression.spel.standard.SpelExpressionParser;
import org.springframework.expression.spel.support.StandardEvaluationContext;
import org.springframework.stereotype.Service;

@Service
public class JsonVaildWithSpel {

	 private final ExpressionParser parser = new SpelExpressionParser();
	    private final StandardEvaluationContext context = new StandardEvaluationContext();

	    public boolean validateAction(String action) {
	        String expression = "#action matches '^[a-zA-Z]+$'";
	        context.setVariable("action", action);
	        return parser.parseExpression(expression).getValue(context, Boolean.class);
	    }

	    public boolean validateActionCode(String actionCode) {
	        String expression = "#actionCode matches '^[a-zA-Z]+$'";
	        context.setVariable("actionCode", actionCode);
	        return parser.parseExpression(expression).getValue(context, Boolean.class);
	    }

	    public boolean validateSendersReference(String sendersReference) {
	        String expression = "#sendersReference matches '^[A-Z]{3}-[0-9]{4}$'";
	        context.setVariable("sendersReference", sendersReference);
	        return parser.parseExpression(expression).getValue(context, Boolean.class);
	    }

	    public boolean validateEntityCode(String entityCode) {
	        String expression = "#entityCode matches '^[A-Z]{4}[0-9]{3}$'";
	        context.setVariable("entityCode", entityCode);
	        return parser.parseExpression(expression).getValue(context, Boolean.class);
	    }
	    

	    public String action(String action) {
	    	String expression = "#action matches '^[a-zA-Z]+$' ? 'valid' : 'invalid'";
	        context.setVariable("action", action);
	        return parser.parseExpression(expression).getValue(context, String.class);
			
		}
	    public String actionCode(String actionCode) {
	    	String expression = "#actionCode matches '^[a-zA-Z]+$' ? 'valid' : 'invalid'";
	        context.setVariable("actionCode", actionCode);
	        return parser.parseExpression(expression).getValue(context, String.class);
		}
	    public String sendersReference(String sendersReference) {
	    	String expression = "#sendersReference matches '^[A-Z]{3}-[0-9]{4}$' ? 'valid' : 'invalid'";
	        context.setVariable("sendersReference", sendersReference);
	        return parser.parseExpression(expression).getValue(context, String.class);
			
		}
	    public String entityCode(String entityCode) {
	    	String expression = "#entityCode matches '^[A-Z]{4}[0-9]{3}$' ? 'valid' : 'invalid'";
	        context.setVariable("entityCode", entityCode);
	        return parser.parseExpression(expression).getValue(context, String.class);
			
		}
	}