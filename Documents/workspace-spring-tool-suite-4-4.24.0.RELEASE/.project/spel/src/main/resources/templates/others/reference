import org.springframework.web.bind.annotation.RestController;

import com.example.entity.JsonInputEntity;
import com.example.service.JsonSchemaValidationService;
import com.example.service.JsonVaildWithSpel;

@RestController
@RequestMapping("/validate")
public class JsonSchemaValidationController {

	@Autowired
	private JsonSchemaValidationService validationService;
	@Autowired
	private JsonVaildWithSpel spelValidationService;

	@PostMapping("/json")
	public String validateJson(@RequestBody String jsonInput) {
		try {
			String schemaFilePath = "C:/Users/LOGESHKUMAR/eclipse-workspace/JsonVaildateWithJava/src/main/resources/templates/Schema.json";
			return validationService.validateJson(jsonInput, schemaFilePath);
		} catch (Exception e) {
			return "Error during validation: " + e.getMessage();
		}
	}

	@PostMapping("/validateJson")
	public String validateJsonWithSpel(@RequestBody JsonInputEntity jsonInput) {

		if (!spelValidationService.validateAction(jsonInput.getAction())) {
			return "Invalid action value";
		}

		if (!spelValidationService.validateActionCode(jsonInput.getActionCode())) {
			return "Invalid actionCode value";
		}

		if (!spelValidationService.validateSendersReference(jsonInput.getFilterClause().getSendersReference())) {
			return "Invalid sendersReference value";
		}

		if (!spelValidationService.validateEntityCode(jsonInput.getEntityCode())) {
			return "Invalid entityCode value";
		}
		
		return "JSON is valid";
	}
	
	@PostMapping("/validateTernaryJson")
	public String ternaryJson(@RequestBody JsonInputEntity jsonInput) {
		String action = spelValidationService.action(jsonInput.getAction());
		if(action.contains("invalid")) {
			return "Invalid action value";
			
		}

		String actionCode =spelValidationService.actionCode(jsonInput.getActionCode());
		if (actionCode.contains("invalid")) {
			return "Invalid actionCode value";
		}
		
		String sendersReference =spelValidationService.sendersReference(jsonInput.getFilterClause().getSendersReference());
		if (sendersReference.contains("invalid")) {
			return "Invalid sendersReference value";
		}

		String entityCode =spelValidationService.entityCode(jsonInput.getEntityCode());
		if (entityCode.contains("invalid")) {
			return "Invalid entityCode value";
		}
		
		return "JSON is valid in ternaryJson";
		
	}
}
