    }

    @Test
    void testProcessTemplate() {
        String jsonContent = "{\"key\":\"value\"}";
        String ftlContent = "Template content";
        String expectedOutput = "Processed Template";

        when(jjService.processTemplate(jsonContent, ftlContent)).thenReturn(expectedOutput);

        String result = jjService.processTemplate(jsonContent, ftlContent);

        assertNotNull(result);
        assertEquals(expectedOutput, result);
    }

    @Test
    void testGenerateXml_Success() throws Exception {
        String jsonContent = "{\"key\":\"value\"}";
        String xmlContent = "<xml>content</xml>";
        String jsonResponse = "{\"json\":\"response\"}";

        when(jjService.processTemplate(anyString(), anyString())).thenReturn(xmlContent);
        when(jjService.transformXmlToJson(anyString(), anyString(), anyString(), anyString()))
            .thenReturn(jsonResponse);

        String result = controller.generateXml(jsonContent);

        assertNotNull(result);
        assertTrue(result.contains("json"));
        verify(jjService, times(1)).processTemplate(anyString(), anyString());
    }

    @Test
    void testGenerateXml_Exception() {
        String jsonContent = "{\"key\":\"value\"}";

        when(jjService.processTemplate(anyString(), anyString())).thenThrow(new RuntimeException("Error"));

        String result = controller.generateXml(jsonContent);

        assertNotNull(result);
        assertTrue(result.contains("Error processing template"));
    }

    @Test
    void testFetchTheirReference() {
        ObjectMapper mapper = new ObjectMapper();
        String json = "{\"TFCPCCRT\":{\"Context\":{\"TheirReference\":\"REF123\"}}}";

        try {
            var rootNode = mapper.readTree(json);
            String reference = jjService.fetchTheirReference(rootNode);

            assertEquals("REF123", reference);
        } catch (Exception e) {
            fail("Exception occurred while parsing JSON: " + e.getMessage());
        }
    }
