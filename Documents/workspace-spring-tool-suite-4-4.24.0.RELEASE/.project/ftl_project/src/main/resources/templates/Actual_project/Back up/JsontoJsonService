	    ResponseEntity<String> response = restTemplate.exchange(url, HttpMethod.POST, entity, String.class);

	    if (response.getStatusCode() == HttpStatus.OK && response.getBody() != null) {
	        String xmlResponse = response.getBody();
	        
	        XmlMapper xmlMapper = new XmlMapper();
            Map<String, Object> data = xmlMapper.readValue(xmlResponse, Map.class);
            
            ObjectMapper objectMapper = new ObjectMapper();
            String jsonContent = objectMapper.writeValueAsString(data);
            
            StringWriter out = new StringWriter();
	        try {
	        	Configuration cfg = new Configuration(Configuration.VERSION_2_3_32);

	            Template template = new Template("template_json", new StringReader(ftlFilePath), cfg);

	            
	            Map<String, Object> dataModel = objectMapper.readValue(jsonContent, Map.class);
		        System.out.println(dataModel);
		       
	           
	            template.process(dataModel, out);
	        }
	        catch (IOException e) {
	            e.printStackTrace();
	        }
	        
	            
	            return out.toString();
	       
	    } else {
	        throw new Exception("Failed to fetch the mock URL response.");
	    }
	}
}
