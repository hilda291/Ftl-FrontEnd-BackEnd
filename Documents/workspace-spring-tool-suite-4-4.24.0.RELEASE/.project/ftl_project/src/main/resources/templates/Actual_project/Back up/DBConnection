import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.jdbc.core.BeanPropertyRowMapper;
import org.springframework.jdbc.core.JdbcTemplate;

@SpringBootApplication
public class DBCOnnection implements CommandLineRunner {

   @Autowired
   private JdbcTemplate jdbcTemplate;
    
   public static void main(String[] args) {
       SpringApplication.run(DBCOnnection.class, args);
   }

   @Override
   public void run(String... args) throws Exception {
       String sql = "SELECT SUBSTR(GWY.ERR_TXT,INSTR(GWY.ERR_TXT,'Master', -1, 1)+7,16) AS MASTER_REF FROM  GWYIN GWY WHERE THEIR_REF ='TR-001001' And GWY.MESS_TYPE='TFCPCCRT';";
        
       List<Student> students = jdbcTemplate.query(sql,
               BeanPropertyRowMapper.newInstance(Student.class));
        
       students.forEach(System.out :: println);
   }

}

